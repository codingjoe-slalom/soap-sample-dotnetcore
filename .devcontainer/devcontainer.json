{
  "name": ".NET 9 Codespace",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0", 
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "containerEnv": {
    "ASPNETCORE_URLS": "https://+:5001;http://+:5000",
    "ASPNETCORE_HTTPS_PORT": "5001"
  },
  "forwardPorts": [5000, 5001]
}
